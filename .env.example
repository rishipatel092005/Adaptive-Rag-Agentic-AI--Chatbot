# LLM providers
OPENAI_API_KEY=your_openai_api_key
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=openai/gpt-oss-120b

# Web search
TAVILY_API_KEY=your_tavily_api_key

# Qdrant vector database
QDRANT_URL=https://your-cluster-url
QDRANT_API_KEY=your_qdrant_api_key
QDRANT_CODE_COLLECTION=codebase
QDRANT_DOCS_COLLECTION=guidelines

# Neo4j Aura GraphRAG
NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password
NEO4J_DATABASE=neo4j

# MongoDB persistence
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=adaptive_rag

# Authentication: replace with a private random value of at least 32 characters
JWT_SECRET_KEY=replace_with_a_private_random_secret_at_least_32_characters_long

# Optional API URL override for the Streamlit client / auth compatibility service
API_BASE_URL=http://127.0.0.1:8000
